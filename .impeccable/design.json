  "narrative": {
    "northStar": "Focus + Atlas",
    "overview": "The owner selected Focus for phone and Atlas for desktop. Phone screens give immediate work a clear place; wider screens expose related records and useful context side by side. A compact labelled rail bridges laptop widths. The interface is matter-of-fact, readable and precise, with flat rows, restrained surfaces and direct labels.\n\nThis document describes the implemented application. The latest approved Figma direction in file `rtPqrxzyCazl5XIIaorQ7Y` (start `60:996`, Focus `40:997`, Atlas `40:998`, Library `45:1349` / `45:1818`) establishes visual intent; the running source establishes actual tokens and behavior. Earlier directions and the deferred graph Home are outside this system. Preserve existing theme identities, private artwork and personal-data behavior when extending screens.",
    "keyCharacteristics": [
      "One locally served type family with a clear, compact hierarchy.",
      "Flat working rows; surfaces group work and context.",
      "Phone focus expands into desktop context without changing record meaning.",
      "Ten existing palettes and their Capture artwork remain available.",
      "Native controls, visible keyboard focus and readable loading/error states."
    ],
    "rules": [
      {
        "name": "The Theme Authority Rule",
        "body": "Resolve colors through the existing CSS variables. `src/app/globals.css` owns all ten palettes: Default, Pokémon, Hades, Hades II, Hollow Knight, Silksong, Elden Ring, Cyberpunk 2077, The Witcher 3 and Stardew Valley. `src/lib/theme.ts` owns their names, previews and browser color metadata. Do not infer new palette-to-feature mappings from preview swatches.",
        "section": "colors"
      },
      {
        "name": "The Semantic Status Rule",
        "body": "Danger, waiting and success retain the shared semantic foreground, muted text and border families in `src/app/semantic-status.css`. Their pale status backgrounds need readable foregrounds even when a theme remaps the slate scale.",
        "section": "colors"
      },
      {
        "name": "The Readable Control Rule",
        "body": "Inputs use the compact control role with a minimum touchable height; coarse-pointer inputs increase to the body size. Authentication inputs and textareas already use the body size. Keep browser zoom available and preserve native date, select and file input behavior.",
        "section": "typography"
      },
      {
        "name": "The Context Follows Space Rule",
        "body": "Expose additional context when the available width supports it. Keep the phone's selected record and action understandable on their own.",
        "section": "layout"
      }
    ],
    "dos": [
      "**Do** use the existing theme variables and semantic status families for every new surface.",
      "**Do** retain labelled phone navigation, compact laptop navigation and wider desktop context.",
      "**Do** wrap record titles and supporting content, including long unbroken strings.",
      "**Do** preserve native controls, keyboard focus, inert modal backgrounds and safe-area clearance.",
      "**Do** use real private artwork when available and explicit text fallbacks when it is unavailable."
    ],
    "donts": [
      "**Don't** introduce a new visual metaphor or inherit an archived Figma direction.",
      "**Don't** turn the deferred graph Home into the navigation model.",
      "**Don't** invent palette mappings, decorative emoji, promotional eyebrows or nested decorative card stacks.",
      "**Don't** encode private records, screenshots, credentials or trial host details in design documentation.",
      "**Don't** change record semantics, authentication, permissions or data behavior as part of visual extension."
    ]
  }
