# Copy to .env and replace these values before starting Compose.
POSTGRES_PASSWORD=replace-with-a-long-random-password
PCC_DEFAULT_USER_EMAIL=owner@example.com

# Temporary password for the owner's first login. Use at least 12 characters.
# Remove this value after the first successful login; the password is then hashed in PostgreSQL.
PCC_OWNER_BOOTSTRAP_PASSWORD=replace-with-a-temporary-owner-password

# Local SSH-tunnel mode:
PCC_PUBLIC_URL=http://localhost:3000
PCC_COOKIE_SECURE=0

# HTTPS phone mode, after Tailscale Funnel works:
# PCC_PUBLIC_URL=https://personal-control-center.your-tailnet.ts.net
# PCC_COOKIE_SECURE=1
# PCC_FUNNEL_ENABLED=1
# TAILSCALE_HOSTNAME=personal-control-center
# TAILSCALE_AUTH_KEY=paste-a-one-off-non-ephemeral-auth-key-directly-on-the-server
PCC_FUNNEL_ENABLED=0
TAILSCALE_HOSTNAME=personal-control-center
TAILSCALE_AUTH_KEY=

PCC_SESSION_DAYS=30
PCC_INVITE_DAYS=7

# Match the Linux user that owns this checkout (`id -u` and `id -g`).
PCC_HOST_UID=1000
PCC_HOST_GID=1000

# Daily validated local PostgreSQL and upload backups under ./data/backups.
PCC_BACKUP_INTERVAL_HOURS=24
PCC_BACKUP_RETENTION_DAYS=14

# Optional encrypted, deduplicated Cloudflare R2 backups.
# See docs/offsite-backups.md before enabling.
PCC_R2_ENABLED=0
PCC_R2_REPOSITORY=
PCC_R2_REGION=auto
PCC_R2_ACCESS_KEY_ID_FILE=/run/secrets/r2-access-key-id
PCC_R2_SECRET_ACCESS_KEY_FILE=/run/secrets/r2-secret-access-key
PCC_RESTIC_PASSWORD_FILE=/run/secrets/restic-password
PCC_RESTIC_HOSTNAME=personal-control-center-pi
PCC_R2_MAX_BACKUP_AGE_HOURS=36

# Automated tests only. Never enable this on a real deployment.
PCC_ALLOW_INSECURE_USER_HEADER=0
